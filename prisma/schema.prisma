generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// User
// Role
// Employee
// Department
// Designation



// ===================================COMPANY======================================
enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
model Company{
  id     Int  @id @default(autoincrement())
  name   String
  slug   String @unique
  email  String
  phone  String
  address String
  status CompanyStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employees Employee[]
  roles     Role[]
  attendances Attendance[]
  attendanceLogs AttendanceLog[]
  workPolicies WorkPolicy[]
  CompanySettings CompanySetting[]
  Shifts Shift[]
  salaryComponents SalaryComponent[]
  employeeSalaryComponents EmployeeSalaryComponent[]
  payRollRuns PayRollRun[]
  memberships Membership[]
  leaveTypes LeaveType[]
  leaveBalances LeaveBalance[]
  leaveApplications LeaveApplication[]
  holidays Holiday[]
  weeklyOffConfigs WeeklyOffConfig[]
  designations Designation[]



}
// =================================================================================

model Department {
  id        Int       @id @default(autoincrement())
  title     String
  statusId  Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  companyId Int       
  branchId  Int?       
  employees Employee[]
  designations Designation[]

  @@map("departments")
}

enum DesignationStatus {
  ACTIVE
  INACTIVE
}

model Designation {
id Int @id @default(autoincrement())
companyId Int
 branchId Int?
departmentId Int?
title String @db.VarChar(100)
 code String?
level Int?
  status DesignationStatus @default(ACTIVE)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
deletedAt DateTime?
 company Company @relation( fields: [companyId], references: [id])
department Department? @relation(   fields: [departmentId],   references: [id] )
employees Employee[]

  @@unique([  companyId,  departmentId,  title])
@@index([companyId])
 @@index([departmentId])
@@map("designations")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  phone    String?
  password String

  // roleId  Int @default(3)
  // role  Role @relation(fields:[roleId],references: [id])
  // isAdmin Boolean @default(false)
  globalRoleId Int?
  globalRole  GlobalRole? @relation(fields: [globalRoleId], references: [id])


  status   UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  employees    Employee[]
  // attendances Attendance[]
  memberships Membership[]
}

model GlobalRole{
  id       Int       @id @default(autoincrement())
  name     String @unique
  description String?
   users      User[]
}

// model UserGlobalRole{

// }


// ============================================================================================
model Role {
  id        Int      @id @default(autoincrement())
  companyId Int
  company Company @relation(fields: [companyId],references: [id])

  name      String   @unique  // Admin, HR, Employee
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employees Employee[]
  memberships Membership[]

 
}

// ======================================================================================================

// ===============================================MEMBERSHIP================================================
enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
model Membership{
  id   Int @id @default(autoincrement())
 userId    Int
  user      User     @relation(fields: [userId], references: [id])
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])

  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])

  status    MembershipStatus @default(ACTIVE)

  joinedAt  DateTime @default(now())
   @@unique([userId, companyId])
 
}
enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
model Employee {
  id     Int @id @default(autoincrement())
  userId Int?
 user User? @relation(fields: [userId], references: [id])
 companyId Int
 company Company @relation(fields: [companyId],references: [id])
 name String
 phone String
 email String @unique
 roleId Int @default(1)
 role Role @relation(fields:[roleId], references: [id])
 status EmployeeStatus @default(ACTIVE)
  employeeCode  String?
  departmentId  Int?
  department  Department? @relation(fields: [departmentId], references: [id])
  designationId Int?
  designation Designation? @relation(fields: [designationId], references: [id])
  // managerId     Int?
  shiftId Int?
  shift Shift? @relation(fields: [shiftId], references: [id])
  joiningDate    DateTime?
  // employmentType String? // Permanent, Contractual
  // status         String? // active, resigned
    createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attendances Attendance[]
  attendanceLogs AttendanceLog[]
 employeeSalaryComponents EmployeeSalaryComponent[]
  payRolls PayRoll[]
  leaveApplications LeaveApplication[]
  leaveBalances LeaveBalance[]
  employeePersonalInfo EmployeePersonalInfo?
  employeeAddress EmployeeAddress?
  employeeDocuments EmployeeDocument[]
@@index([companyId])
 
}
// ========================================EmployeePersonalInfo===========================================

model EmployeePersonalInfo {
  id Int @id @default(autoincrement())
  employeeId Int @unique
  employee Employee  @relation(fields: [employeeId],references: [id] )
  dob DateTime?
  gender String?
  bloodGroup String?
  maritalStatus String?
  fatherName String?
  motherName String?
  nationality String?
  religion String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// ===================================EmployeeAddress============================================
model EmployeeAddress {
  id Int @id @default(autoincrement())
  employeeId Int @unique
  employee Employee  @relation(   fields: [employeeId],   references: [id] )
  presentAddress String?
  permanentAddress String?
  city String?
  state String?
  country String?
  pinCode String?
  createdAt DateTime   @default(now())
  updatedAt DateTime  @updatedAt
}
// ===========================================EmployeeDocument===============================================
enum EmployeeDocumentStatus {
  ACTIVE
  INACTIVE
}
model EmployeeDocument {
  id Int @id @default(autoincrement())
  employeeId Int
  employee Employee  @relation(  fields: [employeeId],  references: [id])
  title String
  documentType String
  documentNumber String?
  fileUrl String
  fileName String?
  mimeType String?
  fileSize Int?
  isVerified Boolean @default(false)
  verifiedAt DateTime?
  status EmployeeDocumentStatus  @default(ACTIVE)
  uploadedAt DateTime @default(now())
  updatedAt DateTime  @updatedAt
}
// =================================ATTENDANCE====================================
model Attendance{
  id     Int @id @default(autoincrement())
  employeeId Int
  employee Employee @relation(fields: [employeeId],references: [id])
  companyId Int
  company Company @relation(fields: [companyId],references: [id])

  date DateTime
  status String  

  total_work_minutes Int @default(0)
  overtime_minutes Int @default(0)
  late_minutes Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attendanceLogs AttendanceLog[]
  @@unique([employeeId,date])
}
// =======================================================================================

// ========================================ATTENDANCE LOG====================================
model AttendanceLog{
  id     Int @id @default(autoincrement())
   employeeId Int
  employee Employee @relation(fields: [employeeId],references: [id])
  companyId Int
  company Company @relation(fields: [companyId],references: [id])
  // ***** pore ? hatate hobe
    attendanceId Int?  // 🔥 foreign key
  attendance Attendance? @relation(fields: [attendanceId], references: [id])
// in/out--
  type String  
   latitude  Float?
  longitude Float?
  time DateTime
  source String?
  createdAt DateTime @default(now())
}
// ============================================================================================

// ========================================WORKPOLICY=============================================
enum AttendanceMode {
  SINGLE
  MULTI
}
model WorkPolicy{
   id     Int @id @default(autoincrement())
     companyId Int
  company Company @relation(fields: [companyId],references: [id])
  std_work_minutes Int
  overtime_minutes Int
  late_minutes Int
  half_day_threshold Int
  attendance_mode AttendanceMode @default(MULTI)
  createdAt DateTime @default(now())
}
// =====================================================================================================

// ===========================================COMPANY SETTINGS=============================================
model CompanySetting{
  id     Int @id @default(autoincrement())
     companyId Int
  company Company @relation(fields: [companyId],references: [id])
  config Json
    createdAt DateTime @default(now())
     updatedAt DateTime @updatedAt
}
// ============================================================================================================

// ================================================SHIFT=========================================================
enum ShiftStatus {
  ACTIVE
  INACTIVE
}

model Shift {
  id Int @id @default(autoincrement())
  companyId Int
  company Company @relation(fields: [companyId],references: [id])
  title String
  code String?
  description String?
  startTime String
  endTime String
  breakMinutes Int @default(0)
  graceMinutes Int  @default(0)
  lateAfterMinutes Int  @default(0)
  halfDayAfterMinutes Int?
  overtimeAfterMinutes Int  @default(0)
  minimumWorkMinutes Int?
  status ShiftStatus @default(ACTIVE)
 createdAt DateTime  @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  employees Employee[]
  @@index([companyId])
  @@unique([  companyId,   title])
}
// ===================================================================================================================
// =====================================================salary COMPONENT================================
enum SalaryComponentType {
  EARNING
  DEDUCTION
}
model SalaryComponent {
  id Int @id @default(autoincrement())

  companyId Int

  name String
  code String

  type SalaryComponentType

  company Company @relation(fields: [companyId], references: [id])

  employeeSalaryComponents EmployeeSalaryComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyId, code])
}

// ======================M to M==================EMPLOYEE SALARY COMPONENT==============================
model EmployeeSalaryComponent {
  id Int @id @default(autoincrement())
companyId Int
  employeeId Int

  salaryComponentId Int

  amount Float
 company Company @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([employeeId, salaryComponentId])
  @@index([employeeId])
@@index([salaryComponentId])
@@index([companyId])
}


// ====================================================================================================================

// ===================================================PAYROLL============================================================
enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}
model PayRoll{
  id     Int @id @default(autoincrement())
  payroll_run_id Int
 payrollRun PayRollRun @relation(fields: [payroll_run_id], references: [id])
 
  employeeId Int
  employee Employee @relation(fields: [employeeId],references: [id])
  total_days Int
  present_days Int
  paid_leave_days Int
  lop_days Int
  payable_days Int
  gross_salary Float
overtime_amount Float @default(0)
  total_deduction Float
  net_salary Float
  status PayrollStatus @default(DRAFT)
  payrollSnapComponents PayrollSnapComponent[]
   createdAt DateTime @default(now())
   @@unique([payroll_run_id, employeeId])
   @@index([employeeId])
@@index([payroll_run_id])
   
}
// ======================================================Pay ROLL Snap=======================================
model PayrollSnapComponent {
  id Int @id @default(autoincrement())

  payrollId Int

  componentName String

  componentCode String

  type SalaryComponentType
  standardAmount Float
  amount Float

  payroll PayRoll @relation(fields: [payrollId], references: [id])

  createdAt DateTime @default(now())
  @@index([payrollId])
}
// =====================================================================================================================

// ===================================================PAY ROLE RUN=====================================================
enum PayrollRunStatus {
  DRAFT
  FINALIZED
}
// model PayRollRun{

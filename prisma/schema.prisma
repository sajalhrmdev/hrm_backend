model PayRollRun {

  id     Int @id @default(autoincrement())
  companyId Int
  title String?
  periodStart DateTime
  periodEnd DateTime
  createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

  status PayrollRunStatus @default(DRAFT)

  payrolls PayRoll[]

  company Company @relation(fields: [companyId],references: [id])
  @@index([companyId])
   @@unique([companyId,periodStart,periodEnd])
}
// =====================================================================================================================

// ========================================================LEAVE MANAGEMENT=====================

// =======================================================LEAVETYPE==================================================
model LeaveType{
   id     Int @id @default(autoincrement())
  companyId Int
 
  name  String
  code   String
  is_paid Boolean @default(true)
  is_active Boolean @default(true)
  carryForward  Boolean  @default(false)
  maxDays       Int?
  config Json?
   createdAt DateTime @default(now())
     updatedAt     DateTime @updatedAt
     leaveApplications LeaveApplication[]
     leaveBalances LeaveBalance[]
     company Company @relation(fields: [companyId],references: [id])
     @@unique([companyId, code])

}
// ==========================================================================================================

// ============================================LEAVE BALANCE================================================
model LeaveBalance{
  id     Int @id @default(autoincrement())
  employeeId Int
companyId Int
  leaveTypeId Int

  total_allocated Float
  used  Float    @default(0)
 
  year Int
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  employee    Employee @relation(fields: [employeeId], references: [id])
company Company @relation(fields: [companyId],references: [id])

   @@unique([employeeId, leaveTypeId, year, companyId])
}

// =================================================================================================================

// ============================================LEAVE APPLICATION================================================
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}
model LeaveApplication {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  companyId   Int
  leaveTypeId Int
 
  fromDate   DateTime
  toDate     DateTime
  totalDays   Float
 
leaveMode String? // FULL, HALF

  paidDays Float
  unpaidDays Float

  reason      String?
  attachment String?

  status      LeaveStatus @default(PENDING) // PENDING, APPROVED, REJECTED

  approvedBy  Int? // manager/admin id
  approvedAt  DateTime?

  applied_at   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id])
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  company     Company @relation(fields: [companyId], references: [id])
}
// =====================================HOLIDAY=========================
enum HolidayType {
  NATIONAL
  FESTIVAL
  COMPANY
  OPTIONAL
}

model Holiday {

  id Int @id @default(autoincrement())

  companyId Int

  title String

  date DateTime

  type HolidayType

  isPaid Boolean @default(true)

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId],references: [id] )

  @@index([companyId])

  @@index([date])
}
// ===============================================weekly off config====================
model WeeklyOffConfig {

  id Int @id @default(autoincrement())

  companyId Int

  dayOfWeek Int
  // 0 = Sunday
  // 6 = Saturday

  weekNumber Int?
  // null = every week
  // 1 = first
  // 2 = second
  // 3 = third
  // 4 = fourth
  // 5 = fifth

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt 

  company Company @relation( fields: [companyId], references: [id])

  @@index([companyId])
}
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}





// ===================================COMPANY======================================
enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
model Company{
  id     Int  @id @default(autoincrement())
  name   String
  slug   String @unique
  email  String
  phone  String
  address String

  logo       String?
  favicon    String?
  website    String?
  faviconPublicId String?
  logoPublicId String?

 mobileThemeId   Int?
  mobileTheme     MobileTheme? @relation(fields: [mobileThemeId], references: [id])

  status CompanyStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employees Employee[]
  roles     Role[]
  attendances Attendance[]
  attendanceLogs AttendanceLog[]
  workPolicies WorkPolicy[]
  CompanySettings CompanySetting[]
  Shifts Shift[]
  salaryComponents SalaryComponent[]
  employeeSalaryComponents EmployeeSalaryComponent[]
  payRollRuns PayRollRun[]
  memberships Membership[]
  leaveTypes LeaveType[]
  leaveBalances LeaveBalance[]
  leaveApplications LeaveApplication[]
  holidays Holiday[]
  weeklyOffConfigs WeeklyOffConfig[]
  designations Designation[]
  payrollAdjustments PayrollAdjustment[]
  employeeBankDetails EmployeeBankDetail[]
  employeeEmergencyContacts EmployeeEmergencyContact[]
  employeeExperiences EmployeeExperience[]
  attendanceAdjustments AttendanceAdjustment[]
  workSchedulePolicies WorkSchedulePolicy[]
  leaveIncrementPolicies LeaveIncrementPolicy[]
  leaveIncrementLogs LeaveIncrementLog[]
  notices Notice[]
  officeLocations OfficeLocation[]
  performanceReviews PerformanceReview[]
  employeeRewards EmployeeReward[]
  emailSettings EmailSettings?
  emailTemplates EmailTemplate[]
  resignations Resignation[]
  




}
enum OfficeLocationStatus {
  ACTIVE
  INACTIVE
}
model OfficeLocation {
  id Int @id @default(autoincrement())
  companyId Int
  name String
  address String?
  city String?
  state String?
  country String?
  pinCode String?
  latitude Float?
  longitude Float?
  radius Int? @default(100)
  status OfficeLocationStatus @default(ACTIVE)
  company Company @relation(   fields: [companyId],   references: [id] )
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, id])
}
// =================================================================================

model Department {
  id        Int       @id @default(autoincrement())
  title     String
  statusId  Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  companyId Int       
  branchId  Int?       
  employees Employee[]
  designations Designation[]

  @@map("departments")
}

enum DesignationStatus {
  ACTIVE
  INACTIVE
}

model Designation {
id Int @id @default(autoincrement())
companyId Int
 branchId Int?
departmentId Int?
title String @db.VarChar(100)
 code String?
level Int?
  status DesignationStatus @default(ACTIVE)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
deletedAt DateTime?
 company Company @relation( fields: [companyId], references: [id])
department Department? @relation(   fields: [departmentId],   references: [id] )
employees Employee[]

  @@unique([  companyId,  departmentId,  title])
@@index([companyId])
 @@index([departmentId])
@@map("designations")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  phone    String?
  password String

  // roleId  Int @default(3)
  // role  Role @relation(fields:[roleId],references: [id])
  // isAdmin Boolean @default(false)
  globalRoleId Int?
  globalRole  GlobalRole? @relation(fields: [globalRoleId], references: [id])


  status   UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  employees    Employee[]
  // attendances Attendance[]
  memberships Membership[]
   attendanceAdjustments AttendanceAdjustment[] @relation("AttendanceAdjustedBy")
  
}

model GlobalRole{
  id       Int       @id @default(autoincrement())
  name     String @unique
  description String?
   users      User[]
}

// model UserGlobalRole{

// }


// ============================================================================================
model Role {
  id        Int      @id @default(autoincrement())
  companyId Int
  company Company @relation(fields: [companyId],references: [id])
  name      String     // Admin, HR, Employee
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employees Employee[]
  memberships Membership[]
  rolePermissions RolePermission[]
  @@unique([companyId, name])
  @@index([companyId])
}
// ======================================================================================================

// ==================================================PERMISSION==============================================
model Permission {
  id Int @id @default(autoincrement())
  name String @unique
  label String?
  createdAt DateTime @default(now())
  rolePermissions RolePermission[]
}
// =================================================ROLE PERMISSION==========================================
model RolePermission {
  id Int @id @default(autoincrement())
  roleId Int
  permissionId Int
  role Role @relation(fields:[roleId],references:[id])
  permission Permission @relation(fields:[permissionId],references:[id])
  @@unique([  roleId,  permissionId])
  @@index([roleId])
  @@index([permissionId])
}
// ===============================================MEMBERSHIP================================================
enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
model Membership{
  id   Int @id @default(autoincrement())
 userId    Int
  user      User     @relation(fields: [userId], references: [id])
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])

  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])

  status    MembershipStatus @default(ACTIVE)

  joinedAt  DateTime @default(now())
   @@unique([userId, companyId])
 
}
enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
model Employee {
  id     Int @id @default(autoincrement())
  userId Int?
 user User? @relation(fields: [userId], references: [id])
 companyId Int
 company Company @relation(fields: [companyId],references: [id])
 name String
 phone String
 email String @unique
 roleId Int ?
 role Role? @relation(fields:[roleId], references: [id])
 status EmployeeStatus @default(ACTIVE)
  employeeCode  String?
  departmentId  Int?
  department  Department? @relation(fields: [departmentId], references: [id])
  designationId Int?
  designation Designation? @relation(fields: [designationId], references: [id])
  // managerId     Int?
  shiftId Int?
  shift Shift? @relation(fields: [shiftId], references: [id])
  joiningDate    DateTime?
  workSchedulePolicyId Int?
workSchedulePolicy WorkSchedulePolicy? @relation( fields:[workSchedulePolicyId], references:[id])
  // employmentType String? // Permanent, Contractual
  // status         String? // active, resigned
    createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attendances Attendance[]
  attendanceLogs AttendanceLog[]
 employeeSalaryComponents EmployeeSalaryComponent[]
  payRolls PayRoll[]
  leaveApplications LeaveApplication[]
  leaveBalances LeaveBalance[]
  employeePersonalInfo EmployeePersonalInfo?
  employeeAddress EmployeeAddress?
  employeeDocuments EmployeeDocument[]
  payrollAdjustments PayrollAdjustment[]
  employeeBankDetail EmployeeBankDetail?
  employeeEmergencyContact EmployeeEmergencyContact?
  employeeExperiences EmployeeExperience[]
  attendanceAdjustments AttendanceAdjustment[]
  leaveIncrementLogs LeaveIncrementLog[]
  employeeFace EmployeeFace?
   performanceReviews PerformanceReview[]
   employeeRewards EmployeeReward[]
   resignations Resignation[]
   approvedResignations Resignation[] @relation("ApprovedResignations")
  
@@index([companyId])
 
}
// ========================================EmployeePersonalInfo===========================================

model EmployeePersonalInfo {
  id Int @id @default(autoincrement())
  employeeId Int @unique
  employee Employee  @relation(fields: [employeeId],references: [id] )
  dob DateTime?
  gender String?
  bloodGroup String?
  maritalStatus String?
  fatherName String?
  motherName String?
  nationality String?
  religion String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// ===================================EmployeeAddress============================================
model EmployeeAddress {
  id Int @id @default(autoincrement())
  employeeId Int @unique
  employee Employee  @relation(   fields: [employeeId],   references: [id] )
  presentAddress String?
  permanentAddress String?
  city String?
  state String?
  country String?
  pinCode String?
  createdAt DateTime   @default(now())
  updatedAt DateTime  @updatedAt
}
// ======================================================
// EMPLOYEE EMERGENCY CONTACT
// ======================================================
model EmployeeEmergencyContact {
  id Int @id @default(autoincrement())
  companyId Int
  company Company @relation( fields:[companyId],references:[id])
  employeeId Int @unique
  employee Employee @relation(fields:[employeeId],references:[id])
  contactName String?
  relationship String?
  phone String?
  alternatePhone String?
  email String?
  address String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId])
}
// ===========================================EmployeeDocument===============================================
enum EmployeeDocumentStatus {
  ACTIVE
  INACTIVE
}
model EmployeeDocument {
  id Int @id @default(autoincrement())
  employeeId Int
  employee Employee  @relation(  fields: [employeeId],  references: [id])
  title String
  documentType String
  documentNumber String?
  fileUrl String
  fileName String?
  mimeType String?
  fileSize Int?
  isVerified Boolean @default(false)
  verifiedAt DateTime?
  status EmployeeDocumentStatus  @default(ACTIVE)
  uploadedAt DateTime @default(now())
  updatedAt DateTime  @updatedAt
}

// ========================================BANK====================================
model EmployeeBankDetail {
  id Int @id @default(autoincrement())
  companyId Int 
 company Company @relation(fields: [companyId],references: [id])
  employeeId Int  @unique
  employee Employee @relation(fields:[employeeId],references:[id])
  bankName String?
  accountHolderName String?
  accountNumber String?
  ifscCode String?
  branchName String?
  upiId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// ====================================EXPERIANCE=======================
model EmployeeExperience {
  id Int @id @default(autoincrement())
  companyId Int
  company Company @relation(fields:[companyId],references:[id])
  employeeId Int
  employee Employee @relation( fields:[employeeId], references:[id])

  companyName String

  designation String

  startDate DateTime

  endDate DateTime?

  currentlyWorking Boolean @default(false)

  skills String?

  responsibilities String?

  documentUrl String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([companyId])

  @@index([employeeId])
}
// =================================ATTENDANCE====================================
enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  WEEKLY_OFF
  HOLIDAY
  PAID_LEAVE
  UNPAID_LEAVE
  ON_DUTY
  WORK_FROM_HOME
}
model Attendance{
  id     Int @id @default(autoincrement())
  employeeId Int
  employee Employee @relation(fields: [employeeId],references: [id])
  companyId Int
  company Company @relation(fields: [companyId],references: [id])

  date DateTime
  status AttendanceStatus @default(PRESENT)
  shiftId Int?
  shift Shift? @relation(fields: [shiftId], references: [id])
  check_in_time DateTime?

  check_out_time DateTime?

  total_work_minutes Int @default(0)
  overtime_minutes Int @default(0)
  late_minutes Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attendanceLogs AttendanceLog[]
  attendanceAdjustments AttendanceAdjustment[]
  @@unique([employeeId,date])
  @@index([companyId])

@@index([date])

@@index([shiftId])
}
// =======================================================================================
// ===========================EmployeeFace==============================
model EmployeeFace {
  id         Int      @id @default(autoincrement())

  employeeId Int      @unique
  publicId   String
  imageUrl   String
  embedding  Json?
  
  createdAt  DateTime @default(now())

  updatedAt  DateTime @updatedAt

  employee Employee @relation(   fields: [employeeId],   references: [id] )
}
// =======================================ATTENDANCE ADJUSTMENT==========================
enum AttendanceAdjustmentType {

  MANUAL

  GRACE

  REGULARIZATION

  AUTO_CORRECTION

  SYSTEM
}
model AttendanceAdjustment {

  id Int @id @default(autoincrement())

  companyId Int

  attendanceId Int

  employeeId Int

  adjustedBy Int?

  company Company @relation(   fields: [companyId],   references: [id] )

  attendance Attendance @relation(   fields: [attendanceId],   references: [id],   onDelete: Cascade )

  employee Employee @relation(   fields: [employeeId],  references: [id])

  attendanceAdjustedBy User? @relation( "AttendanceAdjustedBy", fields: [adjustedBy],   references: [id] )

  oldStatus AttendanceStatus?

  newStatus AttendanceStatus?

  lateGraceMinutes Int @default(0)

  workGraceMinutes Int @default(0)

  reason String?

  remarks String?

  metadata Json?

  actionType AttendanceAdjustmentType @default(MANUAL)

  createdAt DateTime @default(now())

  @@index([companyId])

  @@index([employeeId])

  @@index([attendanceId])

  @@index([createdAt])

  @@index([actionType])
}

// ========================================ATTENDANCE LOG====================================
model AttendanceLog{
  id     Int @id @default(autoincrement())
   employeeId Int
  employee Employee @relation(fields: [employeeId],references: [id])
  companyId Int
  company Company @relation(fields: [companyId],references: [id])
  // ***** pore ? hatate hobe
    attendanceId Int?  // 🔥 foreign key
  attendance Attendance? @relation(fields: [attendanceId], references: [id])

  type String  
   latitude  Float?
  longitude Float?
  time DateTime
  source String?
  shiftName String?

shiftStartTime String?

shiftEndTime String?
  createdAt DateTime @default(now())
  @@index([employeeId])

@@index([attendanceId])

@@index([companyId])

@@index([time])
}
// ============================================================================================

// ========================================WORKPOLICY=============================================
enum AttendanceMode {
  SINGLE
  MULTI
}
model WorkPolicy{
   id     Int @id @default(autoincrement())
     companyId Int
  company Company @relation(fields: [companyId],references: [id])
  std_work_minutes Int
  overtime_minutes Int
  late_minutes Int
  half_day_threshold Int
  attendance_mode AttendanceMode @default(MULTI)
  createdAt DateTime @default(now())
}
// =====================================================================================================

// ===========================================COMPANY SETTINGS=============================================
model CompanySetting{
  id     Int @id @default(autoincrement())
     companyId Int
  company Company @relation(fields: [companyId],references: [id])
  config Json
    createdAt DateTime @default(now())
     updatedAt DateTime @updatedAt
}
// ============================================================================================================

// ================================================SHIFT=========================================================
enum ShiftStatus {
  ACTIVE
  INACTIVE
}
enum AttendanceModes {
  SINGLE
  MULTI
}

model Shift {
  id Int @id @default(autoincrement())
  companyId Int
  company Company @relation(fields: [companyId],references: [id])
  title String
  code String?
  description String?
  startTime String
  endTime String
  breakMinutes Int @default(0)
  graceMinutes Int  @default(0)
  lateAfterMinutes Int  @default(0)
  halfDayAfterMinutes Int?
  enableOvertime Boolean @default(false)
  overtimeAfterMinutes Int  @default(0)
  minimumWorkMinutes Int?
  attendanceMode AttendanceModes @default(MULTI)
  status ShiftStatus @default(ACTIVE)
 createdAt DateTime  @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  employees Employee[]
  attendances Attendance[]
  WorkSchedulePolicies WorkSchedulePolicy[]
   
  @@index([companyId])
  @@unique([  companyId,   title])
}
// ===================================================================================================================
// ================================================WORK SCHEDULE POLICY====================================
enum AttendanceType {
  FIXED
  FLEXIBLE
}
enum AttendanceFrom {
  OFFICE
  REMOTE
}
model WorkSchedulePolicy {
  id Int @id @default(autoincrement())
  companyId Int
  title String
  description String?
  attendanceType AttendanceType @default(FIXED)
  attendanceFrom AttendanceFrom @default(OFFICE)
  // FLEXIBLE

  requiredWorkMinutes Int?
  halfDayMinutes Int?
  enableOvertime Boolean @default(false)
  overtimeAfterMinutes Int?
    // FIXED
    shiftId Int?
  shift Shift? @relation(  fields:[shiftId],  references:[id] )
  weeklyOffPattern Json?
  isActive Boolean  @default(true)
  company Company @relation( fields:[companyId], references:[id])
  employees Employee[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId])
  @@unique([companyId, title])
}
// =====================================================salary COMPONENT================================
enum SalaryComponentType {
  EARNING
  DEDUCTION
}
model SalaryComponent {
  id Int @id @default(autoincrement())

  companyId Int

  name String
  code String

  type SalaryComponentType

  company Company @relation(fields: [companyId], references: [id])

  employeeSalaryComponents EmployeeSalaryComponent[]
  payrollAdjustments PayrollAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyId, code])
}

// ======================M to M==================EMPLOYEE SALARY COMPONENT==============================
model EmployeeSalaryComponent {
  id Int @id @default(autoincrement())
companyId Int
  employeeId Int

  salaryComponentId Int

  amount Float
 company Company @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([employeeId, salaryComponentId])
  @@index([employeeId])
@@index([salaryComponentId])
@@index([companyId])
}


// ====================================================================================================================
// ====================================================PAYROLL ADJUSTMENT==========================================
model PayrollAdjustment {
  id Int @id @default(autoincrement())
  companyId Int
  company Company    @relation(fields:[companyId],references:[id])
  payrollRunId Int
  payrollRun PayRollRun @relation(fields:[payrollRunId],references:[id])
  employeeId Int
  employee Employee @relation(fields:[employeeId],references:[id])
  salaryComponentId Int
  salaryComponent SalaryComponent @relation(fields:[salaryComponentId],references:[id])
  amount Float
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([employeeId])
  @@index([payrollRunId])
  @@index([salaryComponentId])

  @@unique([payrollRunId,employeeId,salaryComponentId])
}

// ===================================================PAYROLL============================================================
enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}
model PayRoll{
  id     Int @id @default(autoincrement())
  payroll_run_id Int
 payrollRun PayRollRun @relation(fields: [payroll_run_id], references: [id])
 
  employeeId Int
  employee Employee @relation(fields: [employeeId],references: [id])
  total_days Int
  present_days Int
  paid_leave_days Int
  lop_days Int
  payable_days Int
  gross_salary Float
overtime_amount Float @default(0)
  total_deduction Float
  net_salary Float
  status PayrollStatus @default(DRAFT)
  payrollSnapComponents PayrollSnapComponent[]
   createdAt DateTime @default(now())
   @@unique([payroll_run_id, employeeId])
   @@index([employeeId])
@@index([payroll_run_id])
   
}
// ======================================================Pay ROLL Snap=======================================
model PayrollSnapComponent {
  id Int @id @default(autoincrement())

  payrollId Int

  componentName String

  componentCode String

  type SalaryComponentType
  standardAmount Float
  amount Float

  payroll PayRoll @relation(fields: [payrollId], references: [id])

  createdAt DateTime @default(now())
  @@index([payrollId])
}
// =====================================================================================================================

// ===================================================PAY ROLE RUN=====================================================
enum PayrollRunStatus {
  DRAFT
  FINALIZED
}


model PayRollRun {

  id     Int @id @default(autoincrement())
  companyId Int
  title String?
  periodStart DateTime
  periodEnd DateTime
  createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

  status PayrollRunStatus @default(DRAFT)

  payrolls PayRoll[]

  company Company @relation(fields: [companyId],references: [id])
  payrollAdjustments PayrollAdjustment[]
  @@index([companyId])
   @@unique([companyId,periodStart,periodEnd])
}
// =====================================================================================================================

// ========================================================LEAVE MANAGEMENT=====================

// =======================================================LEAVETYPE==================================================
model LeaveType{
   id     Int @id @default(autoincrement())
  companyId Int
 
  name  String
  code   String
  is_paid Boolean @default(true)
  is_active Boolean @default(true)
  carryForward  Boolean  @default(false)
  maxDays       Int?
  config Json?
   createdAt DateTime @default(now())
     updatedAt     DateTime @updatedAt
     leaveApplications LeaveApplication[]
     leaveBalances LeaveBalance[]
    leaveIncrementPolicies LeaveIncrementPolicy[]
    leaveIncrementLogs LeaveIncrementLog[]
     company Company @relation(fields: [companyId],references: [id])
     @@unique([companyId, code])

}
// ==========================================================================================================

// ============================================LEAVE BALANCE================================================
model LeaveBalance{
  id     Int @id @default(autoincrement())
  employeeId Int
companyId Int
  leaveTypeId Int

  total_allocated Float @default(0)
  used  Float    @default(0)
 remaining Float  @default(0)
  year Int
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  employee    Employee @relation(fields: [employeeId], references: [id])
company Company @relation(fields: [companyId],references: [id])

   @@unique([employeeId, leaveTypeId, year, companyId])
}

// =================================================================================================================
// ==========================================LEAVE INCRIMENT POLICY===============================
enum LeaveIncrementFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
model LeaveIncrementPolicy {

  id Int  @id  @default(autoincrement())

  companyId Int

  leaveTypeId Int

  title String?

  incrementAmount Float

  frequency LeaveIncrementFrequency

  isActive Boolean  @default(true)

  maxLimit Float?

  effectiveFrom DateTime?

  effectiveTo DateTime?

  config Json?

  createdAt DateTime @default(now())

  updatedAt DateTime  @updatedAt

  company Company @relation(   fields:[companyId],   references:[id] )

  leaveType LeaveType  @relation(   fields:[leaveTypeId],   references:[id] )
  leaveIncrementLogs LeaveIncrementLog[]


  @@index([companyId])
 @@index([frequency])
  @@index([leaveTypeId])
}
enum LeaveIncrementStatus {

  PENDING

  COMPLETED

  FAILED

  REVERSED
}
model LeaveIncrementLog {

  id Int  @id  @default(autoincrement())

  companyId Int

  employeeId Int

  leaveTypeId Int

  leaveIncrementPolicyId Int

  amount Float

  frequency LeaveIncrementFrequency

  incrementDate DateTime

  month Int?

  week Int?

  year Int

 status LeaveIncrementStatus @default(PENDING)

  createdAt DateTime  @default(now())

  company Company  @relation(    fields:[companyId],    references:[id]  )

  employee Employee  @relation(    fields:[employeeId],    references:[id]  )

  leaveType LeaveType  @relation(    fields:[leaveTypeId],    references:[id]  )

  leaveIncrementPolicy LeaveIncrementPolicy  @relation(    fields:[leaveIncrementPolicyId],    references:[id]  )
  @@unique([  employeeId,  leaveIncrementPolicyId,  month,  week,  year])

  @@index([companyId])

  @@index([employeeId])

  @@index([leaveTypeId])
}

// ============================================LEAVE APPLICATION================================================
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}
model LeaveApplication {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  companyId   Int
  leaveTypeId Int
 
  fromDate   DateTime
  toDate     DateTime
  totalDays   Float
 
leaveMode String? // FULL, HALF

  paidDays Float
  unpaidDays Float

  reason      String?
  attachment String?

  status      LeaveStatus @default(PENDING) // PENDING, APPROVED, REJECTED

  approvedBy  Int? // manager/admin id
  approvedAt  DateTime?

  applied_at   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id])
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  company     Company @relation(fields: [companyId], references: [id])
}
// =====================================HOLIDAY=========================
enum HolidayType {
  NATIONAL
  FESTIVAL
  COMPANY
  OPTIONAL
}

model Holiday {

  id Int @id @default(autoincrement())

  companyId Int

  title String

  date DateTime

  type HolidayType

  isPaid Boolean @default(true)

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId],references: [id] )

  @@index([companyId])

  @@index([date])
}
// ===============================================weekly off config====================
model WeeklyOffConfig {

  id Int @id @default(autoincrement())

  companyId Int

  dayOfWeek Int
  // 0 = Sunday
  // 6 = Saturday

  weekNumber Int?
  // null = every week
  // 1 = first
  // 2 = second
  // 3 = third
  // 4 = fourth
  // 5 = fifth

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt 

  company Company @relation( fields: [companyId], references: [id])

  @@index([companyId])
}

// ======================================================
// NOTICE PRIORITY
// ======================================================

enum NoticePriority {

  LOW

  NORMAL

  HIGH

  URGENT
}

// ======================================================
// NOTICE
// ======================================================

model Notice {

  id Int  @id  @default(autoincrement())

  companyId Int

  title String

  description String

  noticeDate DateTime

  expiryDate DateTime?

  priority NoticePriority  @default(NORMAL)

  isPublished Boolean  @default(true)

  attachmentUrl String?

  createdBy Int?

  createdAt DateTime  @default(now())

  updatedAt DateTime  @updatedAt

  company Company  @relation(    fields:[companyId],    references:[id]  )

  @@index([companyId])

  @@index([noticeDate])

  @@index([isPublished])
}

// ===============================performance===========================
model PerformanceReview {
  id            Int      @id @default(autoincrement())

  companyId     Int
  employeeId    Int

  punctuality   Int
  teamwork      Int
  productivity  Int

  overallRating Float

  comments      String?

  reviewMonth   Int
  reviewYear    Int

  createdAt     DateTime @default(now())

  company        Company  @relation(fields: [companyId], references: [id])
  employee       Employee @relation(fields: [employeeId], references: [id])
  @@unique([employeeId, reviewMonth, reviewYear])
}
// ==========================================================================
model EmployeeReward {
  id            Int      @id @default(autoincrement())

  companyId     Int
  employeeId    Int

  title         String
  description   String?

  rewardType    String

  rewardAmount  Float?

  rewardDate    DateTime

  createdAt     DateTime @default(now())

  company        Company  @relation(fields: [companyId], references: [id])
  employee       Employee @relation(fields: [employeeId], references: [id])
}


// ================================email setting=======================
model EmailSettings {
  id             Int      @id @default(autoincrement())

  companyId      Int      @unique
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider       String?  // Gmail, Outlook, Zoho, Custom

  smtpHost       String
  smtpPort       Int
  smtpUsername   String
  smtpPassword   String

  encryption     String   @default("TLS") // TLS | SSL | NONE

  fromName       String
  fromEmail      String
  replyTo        String?

  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
}
// =====================================email template===============================
model EmailTemplate {
  id            Int      @id @default(autoincrement())

  companyId     Int
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name          String
  slug          String

  subject       String

  htmlContent   String    @db.Text

  description   String?

  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
}

// =======================================RESIGNATION=================================
enum ResignationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Resignation {
  id               Int              @id @default(autoincrement())
  companyId        Int
  employeeId       Int
  resignationDate  DateTime
  lastWorkingDay   DateTime
  noticePeriodDays Int              @default(30)
  reason           String?
  handoverTo       String?
  status           ResignationStatus @default(PENDING)
  approvedBy       Int?
  approvedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  approver Employee? @relation("ApprovedResignations", fields: [approvedBy], references: [id])

  @@index([companyId])
  @@index([employeeId])
}

// =======================================mobile theme=================================
model MobileTheme {
  id              Int      @id @default(autoincrement())
  name            String   
  slug            String   @unique 
  primaryColor    String  
  secondaryColor  String
  backgroundColor String
  surfaceColor    String
  textColor       String
  isDefault       Boolean  @default(false) 
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  companies       Company[] 
}